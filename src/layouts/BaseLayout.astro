---
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '../styles/global.css';

import SEO from '../components/seo/SEO.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import SkipLink from '../components/layout/SkipLink.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppButton from '../components/ui/WhatsAppButton.astro';
import { organizationSchema } from '../lib/schema';
import { generalWhatsappMessage } from '../data/whatsapp';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'product' | 'article';
  schemas?: Record<string, unknown>[]; // JSON-LD específico de cada página
  noindex?: boolean;
  /** Oculta el WhatsApp flotante en móvil y reserva el espacio final
   *  (`pb-24 md:pb-0`): lo usa la ficha de producto con StickyProductBar. */
  hideFloatingCta?: boolean;
}
const {
  title,
  description,
  image,
  type,
  schemas = [],
  noindex,
  hideFloatingCta = false,
} = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <SEO {title} {description} {image} {type} {noindex} />
    <JsonLd data={[organizationSchema(), ...schemas]} />
  </head>
  {/* El pb vive en <body> y no en <main>: la barra fija es full-width y, si solo
      se reservara espacio en main, taparía la última fila del footer. */}
  <body
    class:list={[
      'flex min-h-screen flex-col bg-white text-neutral',
      hideFloatingCta && 'pb-24 md:pb-0',
    ]}
  >
    <SkipLink />
    <Header />
    <main id="main" class="flex-1"><slot /></main>
    <Footer />
    <!-- CTA global de contacto -->
    <WhatsAppButton
      variant="floating"
      label="Escríbenos"
      message={generalWhatsappMessage()}
      mobileHidden={hideFloatingCta}
    />
  </body>
</html>

<script>
  // Registro de clics en CTAs: cualquier <a data-event="..."> empuja un evento a
  // dataLayer (estándar GA4/GTM). No carga analítica por sí solo: hasta que no se
  // añada la etiqueta de medición no hay tracking ni aviso de cookies (legal.md 8.4).
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const link = target.closest('a[data-event]');
    if (!link) return;
    const store = window as Window & { dataLayer?: Record<string, unknown>[] };
    store.dataLayer ??= [];
    store.dataLayer.push({ event: link.getAttribute('data-event'), href: link.getAttribute('href') });
  });
</script>
