---
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '../styles/global.css';
import '@dennismiranda/astro-cart/styles.css';
import '../styles/cart-theme.css';

import SEO from '../components/seo/SEO.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import SkipLink from '../components/layout/SkipLink.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Cart from '../components/cart/Cart.astro';
import WhatsAppButton from '../components/ui/WhatsAppButton.astro';
import CookieConsent from '../components/layout/CookieConsent.astro';
import { organizationSchema } from '../lib/schema';
import { generalWhatsappMessage } from '../lib/whatsapp';
import type { Legal, Site } from '../api/types';

interface Props {
  /** Identidad del negocio — la trae la página desde el facade y la baja a todo el árbol. */
  site: Site;
  /** Datos legales INDECOPI — para el JSON-LD de LocalBusiness. */
  legal: Legal;
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'product' | 'article';
  schemas?: Record<string, unknown>[]; // JSON-LD específico de cada página
  noindex?: boolean;
  /** Oculta el WhatsApp flotante en móvil y reserva el espacio final
   * (`pb-24 md:pb-0`): lo usa la ficha de producto con StickyProductBar. */
  hideFloatingCta?: boolean;
  /** Página mínima (tipo bio link): sin header, sin footer, sin CTA flotante y
   * sin drawer de cotización, para que los enlaces de la página sean lo único
   * que se ve (la página redirige, no vende). */
  minimal?: boolean;
}
const {
  site,
  legal,
  title,
  description,
  image,
  type,
  schemas = [],
  noindex,
  hideFloatingCta = false,
  minimal = false,
} = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <SEO {site} {title} {description} {image} {type} {noindex} />
    <JsonLd data={[organizationSchema(site, legal), ...schemas]} />
  </head>

  <body
    class:list={[
      'flex min-h-screen flex-col bg-white text-neutral',
      hideFloatingCta && 'pb-24 md:pb-0',
    ]}
  >
    <SkipLink />
    {!minimal && <Header />}
    <main id="main" class="flex-1"><slot /></main>
    {!minimal && <Footer {site} />}
    {/* CTA global: en layout minimal lo reemplazan los enlaces de la página. */}
    {!minimal && (
      <WhatsAppButton
        {site}
        variant="floating"
        label="Escríbenos"
        message={generalWhatsappMessage()}
        mobileHidden={hideFloatingCta}
      />
    )}
    {/* Carrito global: drawer + checkout por WhatsApp. En layout minimal no se
        monta — la página no vende ni cotiza, solo redirige. */}
    {!minimal && <Cart {site} />}
    <CookieConsent />
  </body>
</html>

<script>
  // Registro de clics en CTAs: cualquier <a data-event="..."> empuja un evento a
  // dataLayer (estándar GA4/GTM). No carga analítica por sí solo: hasta que no se
  // añada la etiqueta de medición no hay tracking ni aviso de cookies (legal.md 8.4).
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const link = target.closest('a[data-event]');
    if (!link) return;
    const store = window as Window & { dataLayer?: Record<string, unknown>[] };
    store.dataLayer ??= [];
    store.dataLayer.push({ event: link.getAttribute('data-event'), href: link.getAttribute('href') });
  });

  // Add-to-cart del carrito → dataLayer (GA4).
  document.addEventListener('cart:item:add', (event) => {
    const item = (event as CustomEvent<{ item?: { name?: string; lineTotal?: number } }>).detail?.item;
    const store = window as Window & { dataLayer?: Record<string, unknown>[] };
    store.dataLayer ??= [];
    store.dataLayer.push({
      event: 'add_to_cart',
      item_name: item?.name,
      value: item?.lineTotal,
      currency: 'PEN',
    });
  });
</script>
