---
import { api } from '../../api';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import ProductGrid from '../../components/catalog/ProductGrid.astro';
import CategoryChips from '../../components/catalog/CategoryChips.astro';
import CatalogSearch from '../../components/catalog/CatalogSearch.astro';
import ActiveFilters from '../../components/catalog/ActiveFilters.astro';
import CatalogPagination from '../../components/catalog/CatalogPagination.astro';
import WhatsAppButton from '../../components/ui/WhatsAppButton.astro';
import Callout from '../../components/ui/Callout.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import { breadcrumbSchema, itemListSchema } from '../../lib/schema';
import { categoryWhatsappMessage } from '../../lib/whatsapp';
import Container from '../../components/ui/Container.astro';
import { absUrl } from '../../lib/url';

export async function getStaticPaths() {
  // Genera una ruta por categoría con sus productos ya resueltos en build.
  const categories = await api.categories.list();
  return Promise.all(
    categories.map(async (cat) => ({
      params: { category: cat.slug },
      props: { cat, products: await api.products.byCategory(cat.slug) },
    })),
  );
}

const { cat, products } = Astro.props;
const categories = await api.categories.list();
const site = await api.site.get();
const legal = await api.site.legal();

// Alternativas del estado vacío: destacados de la categoría o, si no
// hubiera, sus primeros 4 productos (la categoría siempre tiene ≥1 aquí).
const featuredInCategory = products.filter((p) => p.featured).slice(0, 4);
const suggestions =
  featuredInCategory.length > 0 ? featuredInCategory : products.slice(0, 4);

const crumbs = [
  { name: 'Inicio', href: '/' },
  { name: 'Catálogo', href: '/catalogo/' },
  { name: cat.name },
];

// GA4 view_item_list: payload serializado en un data-* de la sección para el
// script de initCatalog (máx. 20 ítems, límite GA4 razonable con el catálogo actual).
const viewList = {
  item_list_name: cat.name,
  items: products.slice(0, 20).map((p) => ({ item_id: p.slug, item_name: p.name })),
};
---
<BaseLayout
  {site}
  {legal}
  title={cat.seoTitle ?? cat.name}
  description={cat.seoDescription}
  schemas={[
    breadcrumbSchema(crumbs.map((c) => ({ name: c.name, url: absUrl(site, c.href ?? Astro.url.pathname) }))),
    itemListSchema(products.map((p) => ({ name: p.name, url: absUrl(site, `/producto/${p.slug}/`) }))),
  ]}
>
  <Breadcrumbs items={crumbs} />

  <section class="pb-10" data-view-list={JSON.stringify(viewList)}>
    <Container>
      {/* Cabecera: h1 + descripción completa de la categoría + CTA de asesoría. */}
      <header class="flex flex-col gap-4 pt-6 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <h1 class="text-h1 sm:text-h1-lg font-bold tracking-tight text-ink">{cat.name}</h1>
          <p class="mt-3 max-w-3xl text-sm leading-relaxed text-neutral sm:text-base">
            {cat.intro}
          </p>
        </div>
        <div class="shrink-0 sm:self-start">
          <WhatsAppButton
            {site}
            variant="outline"
            message={categoryWhatsappMessage(cat.name)}
            label="Asesoría por WhatsApp"
          />
        </div>
      </header>

      <div class="mt-6">
        <CategoryChips {categories} activeSlug={cat.slug} />
      </div>

      {products.length > 0 ? (

          <div class="mt-8">
            <CatalogSearch />
          </div>
<div class="flex justify-between items-center">          
  <p id="catalog-count" class="mt-4 text-sm text-neutral" aria-live="polite">
            {products.length === 1 ? '1 producto' : `${products.length} productos`}
          </p>
            <div class="mt-6 flex justify-end">
            <label for="catalog-sort" class="sr-only">Ordenar productos</label>
            <select
              id="catalog-sort"
              class="h-10 rounded-lg border border-slate-200 bg-white px-3 text-sm text-ink transition-colors hover:border-slate-300 focus:border-primary focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none"
            >
              <option value="az">De la A a la Z</option>
              <option value="za">De la Z a la A</option>
              <option value="price-asc">Precio: Menor a mayor</option>
              <option value="price-desc">Precio: Mayor a menor</option>
            </select>
          </div>

</div>



          <ActiveFilters />

          <ProductGrid {site} id="catalog-grid" products={products} class="mt-6" />

          <div
            id="catalog-empty"
            class="mt-10 hidden rounded-xl border border-neutral/20 bg-light p-6"
          >
            <p data-empty-title class="text-base font-semibold text-ink">
              No hay resultados con los filtros actuales
            </p>
            <p class="mt-2 text-sm text-neutral">Mira estas opciones:</p>
            <ProductGrid
              {site}
              id="catalog-suggestions"
              products={suggestions}
              variant="suggestions"
              class="mt-4"
            />
          </div>

          <CatalogPagination />
  
      ) : (
        <Callout tone="info" title="Sin productos publicados">
          Por el momento no hay productos publicados en esta categoría. Consultanos por
          WhatsApp para conocer disponibilidad.
          <div class="mt-4">
            <WhatsAppButton
              {site}
              message={categoryWhatsappMessage(cat.name)}
              label="Consultar disponibilidad"
            />
          </div>
        </Callout>
      )}
    </Container>
  </section>

  {/* Único CTA final de la página (§6.3). */}
  <CtaBand
    {site}
    title="¿Necesitas asesoría para elegir?"
    text={`Te orientamos sobre tallas, medidas y disponibilidad de ${cat.name.toLowerCase()}.`}
    message={categoryWhatsappMessage(cat.name)}
  />
</BaseLayout>

<script>
  import { initCatalog } from '../../scripts/catalog';

  initCatalog({ gridId: 'catalog-grid', emptyId: 'catalog-empty' });
</script>
