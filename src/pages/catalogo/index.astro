---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import CategoryCard from '../../components/catalog/CategoryCard.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import { api } from '../../api';
import { breadcrumbSchema, itemListSchema } from '../../lib/schema';
import { SITE } from '../../data/site';
import { generalWhatsappMessage } from '../../data/whatsapp';
import Container from '../../components/ui/Container.astro';
import PageHeader from '../../components/ui/PageHeader.astro';

const categories = await api.categories.list();

const title = 'Catálogo de productos ortopédicos';
const description =
  'Explora nuestras categorías: rodilleras, bastones y sillas de ruedas con registro sanitario verificado y atención personalizada.';

const crumbs = [
  { name: 'Inicio', href: '/' },
  { name: 'Catálogo' },
];
const abs = (p: string) => new URL(p, SITE.url).href;
---
<BaseLayout
  {title}
  {description}
  schemas={[
    breadcrumbSchema(crumbs.map((c) => ({ name: c.name, url: abs(c.href ?? Astro.url.pathname) }))),
    itemListSchema(categories.map((c) => ({ name: c.name, url: abs(`/catalogo/${c.slug}/`) }))),
  ]}
>
  <Breadcrumbs items={crumbs} />

  <section class="pb-8">
    <Container>
      <PageHeader
        title="Catálogo"
        lead="Encontrá productos ortopédicos por categoría. Todos los publicados cuentan con registro sanitario verificado; si tenés dudas sobre tallas o uso, consultanos por WhatsApp."
      />

      <div class="mt-6 grid gap-4 sm:gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {categories.map((c) => <CategoryCard category={c} />)}
      </div>
    </Container>
  </section>

  <CtaBand
    title="¿No encuentras lo que buscas?"
    text="Escríbenos por WhatsApp y te ayudamos a encontrar el producto que necesitas."
    message={generalWhatsappMessage()}
  />
</BaseLayout>
