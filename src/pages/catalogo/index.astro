---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import CategoryCard from '../../components/catalog/CategoryCard.astro';
import { api } from '../../data/api';
import { breadcrumbSchema, itemListSchema } from '../../lib/schema';
import { SITE } from '../../lib/site';

const categories = api.categories.list();

const title = 'Catálogo de productos ortopédicos';
const description =
  'Explora nuestras categorías: rodilleras, bastones y sillas de ruedas con registro sanitario verificado y atención personalizada.';

const crumbs = [
  { name: 'Inicio', href: '/' },
  { name: 'Catálogo' },
];
const abs = (p: string) => new URL(p, SITE.url).href;
---
<BaseLayout
  {title}
  {description}
  schemas={[
    breadcrumbSchema(crumbs.map((c) => ({ name: c.name, url: abs(c.href ?? Astro.url.pathname) }))),
    itemListSchema(categories.map((c) => ({ name: c.name, url: abs(`/catalogo/${c.slug}/`) }))),
  ]}
>
  <Breadcrumbs items={crumbs} />

  <section class="mx-auto max-w-6xl px-4 py-8">
    <h1 class="font-display text-3xl font-semibold">Catálogo</h1>
    <p class="mt-3 max-w-prose text-neutral">
      Encontrá productos ortopédicos por categoría. Todos los publicados cuentan con registro
      sanitario verificado; si tenés dudas sobre tallas o uso, consultanos por WhatsApp.
    </p>

    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {categories.map((c) => <CategoryCard category={c} />)}
    </div>
  </section>
</BaseLayout>
