---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import LocationCta from '../components/home/LocationCta.astro';
import { SITE } from '../lib/site';

const title = 'Contacto';
const description =
  'Teléfono, correo, horario, WhatsApp y cómo llegar al centro ortopédico. Te atendemos en el horario indicado.';

const crumbs = [
  { name: 'Inicio', href: '/' },
  { name: 'Contacto' },
];
const abs = (p: string) => new URL(p, SITE.url).href;
---
<BaseLayout
  {title}
  {description}
  schemas={[
    {
      '@context': 'https://schema.org',
      '@type': 'ContactPage',
      name: 'Contacto',
      url: abs('/contacto/'),
    },
  ]}
>
  <Breadcrumbs items={crumbs} />

  <section class="mx-auto max-w-6xl px-4 py-8">
    <h1 class="font-display text-3xl font-semibold">Contacto</h1>
    <p class="mt-3 max-w-prose text-neutral">
      Escríbenos por WhatsApp para consultar stock, tallas o coordinar una evaluación. Si prefieres
      llamarnos o escribir por correo, también estamos disponibles en los horarios indicados.
    </p>
    <!-- TODO Fase 9: agregar una referencia de ubicación fácil de reconocer (cercanías,
         punto de referencia) cuando estén confirmados los datos reales. -->
  </section>

  <LocationCta />
</BaseLayout>
