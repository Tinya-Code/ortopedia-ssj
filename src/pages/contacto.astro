---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import LocationCta from '../components/home/LocationCta.astro';
import { SITE } from '../lib/site';
import Container from '../components/ui/Container.astro';
import PageHeader from '../components/ui/PageHeader.astro';

const title = 'Contacto';
const description =
  'Teléfono, correo, horario, WhatsApp y cómo llegar al centro ortopédico. Te atendemos en el horario indicado.';

const crumbs = [
  { name: 'Inicio', href: '/' },
  { name: 'Contacto' },
];
const abs = (p: string) => new URL(p, SITE.url).href;
---
<BaseLayout
  {title}
  {description}
  schemas={[
    {
      '@context': 'https://schema.org',
      '@type': 'ContactPage',
      name: 'Contacto',
      url: abs('/contacto/'),
    },
  ]}
>
  <Breadcrumbs items={crumbs} />

  <section class="pb-8">
    <Container>
      <PageHeader
        title="Contacto"
        lead="Escríbenos por WhatsApp para consultar stock, tallas o coordinar una evaluación. Si prefieres llamarnos o escribir por correo, también estamos disponibles en los horarios indicados."
      />
      <!-- TODO Fase 9: agregar una referencia de ubicación fácil de reconocer (cercanías,
           punto de referencia) cuando estén confirmados los datos reales. -->
    </Container>
  </section>

  <LocationCta />
</BaseLayout>
