---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import LocationCta from '../components/home/LocationCta.astro';
import { SITE } from '../lib/site';
import { whatsappLink, generalWhatsappMessage } from '../lib/whatsapp';
import Container from '../components/ui/Container.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import { icons, type IconName } from '../components/icons/index';

const title = 'Contacto';
const description =
  'Teléfono, correo, horario, WhatsApp y cómo llegar al centro ortopédico. Te atendemos en el horario indicado.';

// Canales de contacto: datos desde la capa de datos, nunca hardcodeados.
const channels: { label: string; value: string; href: string; icon: IconName }[] = [
  {
    label: 'WhatsApp',
    value: 'Escríbenos ahora',
    href: whatsappLink(generalWhatsappMessage()),
    icon: 'message-circle',
  },
  {
    label: 'Teléfono',
    value: SITE.phone,
    href: `tel:${SITE.phone.replace(/\s/g, '')}`,
    icon: 'phone-call',
  },
  { label: 'Correo', value: SITE.email, href: `mailto:${SITE.email}`, icon: 'mail' },
];

const crumbs = [
  { name: 'Inicio', href: '/' },
  { name: 'Contacto' },
];
const abs = (p: string) => new URL(p, SITE.url).href;
---
<BaseLayout
  {title}
  {description}
  schemas={[
    {
      '@context': 'https://schema.org',
      '@type': 'ContactPage',
      name: 'Contacto',
      url: abs('/contacto/'),
    },
  ]}
>
  <Breadcrumbs items={crumbs} />

  <section class="pb-8">
    <Container>
      <PageHeader
        title="Contacto"
        lead="Escríbenos por WhatsApp para consultar stock, tallas o coordinar una evaluación. Si prefieres llamarnos o escribir por correo, también estamos disponibles en los horarios indicados."
      />
      {/* Dato concreto de referencia desde la capa de datos (los valores reales
          pendientes viven en lib/site.ts junto al TODO de datos del negocio). */}
      <p class="mt-4 text-sm text-neutral">
        Punto de referencia: {SITE.address.street}, {SITE.address.city} ({SITE.address.region}).
      </p>
    </Container>
  </section>

  <LocationCta />

  {/* Canales de contacto (§6.5): tarjetas reutilizando el estilo de tarjeta. */}
  <section aria-label="Canales de contacto" class="bg-neutral/5 py-12 md:py-16">
    <Container>
      <div class="grid gap-4 sm:grid-cols-3">
        {channels.map((c) => {
          const Icon = icons[c.icon];
          return (
            <a
              href={c.href}
              target={c.href.startsWith('http') ? '_blank' : undefined}
              rel={c.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="group rounded-card border border-neutral/20 bg-white p-6 shadow-card transition hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md motion-reduce:transition-none"
            >
              <Icon class="size-8 text-primary" />
              <p class="mt-3 font-semibold text-ink">{c.label}</p>
              <p class="mt-1 text-sm text-neutral">{c.value}</p>
            </a>
          );
        })}
      </div>
    </Container>
  </section>
</BaseLayout>
