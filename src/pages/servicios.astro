---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import Container from '../components/ui/Container.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Button from '../components/ui/Button.astro';
import CtaBand from '../components/ui/CtaBand.astro';
import Check from '../components/icons/Check.astro';
import { icons, type IconName } from '../components/icons/index';
import { api } from '../api';
import { categoryWhatsappMessage } from '../lib/whatsapp';

const title = 'Servicios';
const description =
  'Evaluación biomecánica de la pisada, calibración de ayudas técnicas y mantenimiento de sillas de ruedas para tu movilidad.';

// Los datos viven en la capa api (mock de GET /services, src/api/data/services.ts);
// la página solo renderiza el contrato Service[].
const services = await api.services.list();

const crumbs = [
  { name: 'Inicio', href: '/' },
  { name: 'Servicios' },
];
---

<BaseLayout {title} {description}>
  <Breadcrumbs items={crumbs} />

  <section class="pb-4">
    <Container>
      <PageHeader title="Servicios" lead={description} />
    </Container>
  </section>

  {services.map((service) => (
    <section id={service.slug} class="py-6 sm:py-8" style={`background-color: ${service.accent};`}>
      <Container>
        {/* Cabecera: título y descripción a ancho completo, alineados a la izquierda. */}
        <div>
          <h2 class="font-display text-h2 sm:text-h2-lg font-semibold text-ink">{service.title}</h2>
          <p class="mt-4 text-sm leading-6 text-neutral sm:text-base">{service.description}</p>
        </div>

        {/* Fila dividida: problema + solución a un lado, imagen al otro (reverse invierte los lados). */}
        <div class="mt-6 grid gap-6 md:grid-cols-2 md:gap-10">
          <div
            class:list={[
              'order-2 space-y-5',
              service.reverse ? 'md:order-2' : 'md:order-1',
            ]}
          >
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-[0.1em] text-primary">
                ¿En qué casos se necesita?
              </h3>
              <ul class="mt-3 space-y-2">
                {service.cases.map((item) => (
                  <li class="flex gap-2.5 text-sm leading-6 text-neutral">
                    <Check class="mt-1 h-4 w-4 shrink-0 text-primary" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div>
              <h3 class="text-xs font-semibold uppercase tracking-[0.1em] text-primary">
                Solución personalizada
              </h3>
              {service.solution.lead && (
                <p class="mt-3 text-sm leading-6 text-neutral">{service.solution.lead}</p>
              )}
              <ul class="mt-3 space-y-2">
                {service.solution.items.map((item) => (
                  <li class="flex gap-2.5 text-sm leading-6 text-neutral">
                    <Check class="mt-1 h-4 w-4 shrink-0 text-primary" />
                    <span>
                      <span class="font-medium text-ink">{item.label}:</span> {item.text}
                    </span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="flex flex-wrap gap-3 mt-3">
              <Button href={service.href} label="Solicitar información" variant="primary" />
            </div>
          </div>

          <div
            class:list={[
              'order-1 flex flex-col gap-4',
              service.reverse ? 'md:order-1' : 'md:order-2',
            ]}
          >
            <div class="min-h-0 flex-1 overflow-hidden rounded-card border border-neutral/15 bg-white shadow-card">
              <img
                src={typeof service.image === 'string' ? service.image : service.image.src}
                alt={service.imageAlt}
                class="h-full min-h-[260px] w-full object-cover sm:min-h-[340px]"
              />
            </div>

            <div class="flex flex-wrap gap-2">
              {service.points.map((point) => {
                const Icon = icons[point.icon as IconName];
                return (
                  <span
                    class="inline-flex items-center gap-1.5 rounded-full border border-primary/20 bg-white/70 px-3 py-1 text-xs font-medium text-primary"
                  >
                    <Icon class="h-3.5 w-3.5" />
                    {point.label}
                  </span>
                );
              })}
            </div>
          </div>
        </div>
      </Container>
    </section>
  ))}

  <CtaBand
    title="¿Necesitas orientación para elegir el mejor servicio?"
    text="Escríbenos por WhatsApp y te recomendamos la mejor solución según tu caso."
    message={categoryWhatsappMessage('Atención personalizada')} 
  />
</BaseLayout>
