---
import { api } from '../api';
import heroMobileImage from '../assets/home/hero-mobile.webp';
import heroImage from '../assets/home/hero.jpeg';
import evaluacionImage from '../assets/services/evaluacion-ortopedica.jpeg';
import ortesisImage from '../assets/services/ortesis-a-medida.jpeg';
import rehabilitacionImage from '../assets/services/rehabilitacion-asesoria.jpeg';
import type { IconName } from '../components/icons/index';
import Faq from '../components/home/Faq.astro';
import FeaturedCategories from '../components/home/FeaturedCategories.astro';
import Hero from '../components/home/Hero.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import LocationCta from '../components/home/LocationCta.astro';
import PromoModal from '../components/promo/PromoModal.astro';
import ServicesGrid from '../components/home/ServicesGrid.astro';
import Team from '../components/home/Team.astro';
import Testimonials from '../components/home/Testimonials.astro';
import TrustBar from '../components/home/TrustBar.astro';
import WhyUs from '../components/home/WhyUs.astro';
import Button from '../components/ui/Button.astro';
import CtaBand from '../components/ui/CtaBand.astro';
import { generalWhatsappMessage } from '../lib/whatsapp';
import BaseLayout from '../layouts/BaseLayout.astro';
import { faqSchema } from '../lib/schema';

const site = await api.site.get();
const legal = await api.site.legal();

const title = `Centro ortopédico en ${site.address.city}`;
const description =
  'Centro ortopédico con evaluación, ortesis a medida y venta de productos ortopédicos. Atención personalizada y respuesta por WhatsApp.';

const categories = await api.categories.list();

// Datos de la sección: viven en la página (smart), no en data/
const services: { title: string; text: string; href: string; image: ImageMetadata; imageAlt: string }[] = [
  {
    title: 'Evaluación ortopédica',
    text: 'Valoración personalizada de tu caso y recomendación de producto según tus medidas.',
    href: '/servicios/#evaluacion-ortopedica',
    image: evaluacionImage,
    imageAlt: 'Ortopedista evaluando el pie de un paciente durante una valoración',
  },
  {
    title: 'Ortesis a medida',
    text: 'Soportes y ortesis adaptados a tu cuerpo y a tu actividad diaria.',
    href: '/servicios/#ortesis-a-medida',
    image: ortesisImage,
    imageAlt: 'Ajuste de una ortesis a medida en la pierna de un paciente infantil',
  },
  {
    title: 'Rehabilitación y asesoría',
    text: 'Acompañamiento y orientación sobre el uso correcto de cada producto.',
    href: '/servicios/#rehabilitacion-asesoria',
    image: rehabilitacionImage,
    imageAlt: 'Profesional ajustando una férula de rodilla a una paciente en rehabilitación',
  },
];

// Cards glass del hero: 4 productos destacados; cada card abre el detalle.
const featuredProducts = await api.products.featured(4);
const heroFavorites: { image: ImageMetadata; alt: string; href: string }[] = featuredProducts.map(
  (p) => ({
    image: p.images[0].src as ImageMetadata,
    alt: p.images[0].alt,
    href: `/producto/${p.slug}/`,
  }),
);

// Pasos de compra (§5.7) — datos en la página, no en data/.
const steps = [
  { title: 'Consulta', text: 'Escríbenos por WhatsApp contándonos qué necesitas o qué molestia tienes.' },
  { title: 'Asesoría', text: 'Te orientamos sobre talla, medidas y el uso correcto del producto.' },
  { title: 'Confirmación y comprobante', text: 'Confirmamos precio y disponibilidad, y emitimos el comprobante.' },
  { title: 'Entrega o recojo', text: 'Coordinamos la entrega o el recojo en el centro ortopédico.' },
];

// Franja de garantías (§5.1 #6): cada label es un hecho verificable, no una promesa.
// Respaldo: envío → terminos-y-condiciones.astro §4 (L71-77); cambios/devolución y
// garantía legal → cambios-y-devoluciones.astro §1 (L36-39) y §6 (L84-89);
// atención → site.hours + WhatsApp (api/data/site.ts). No hay "pago seguro": el sitio
// no procesa pagos en línea (Callout de terminos §3), por eso el 4º ítem es atención.
const trustItems: { icon: IconName; label: string }[] = [
  { icon: 'truck', label: 'Costo y plazo de envío informados' },
  { icon: 'rotate-ccw', label: 'Cambios y devolución en 10 días' },
  { icon: 'shield-check', label: 'Garantía legal en cada producto' },
  { icon: 'message-circle', label: 'Atención por WhatsApp, Lun–Sáb 9:00–19:00' },
];

// Reseñas de prueba social (§5.1 #4). PLACEHOLDER autorizado por el usuario:
// reseñas inventadas con autorización del usuario — sustituir por reseñas reales
// (requieren backend/CMS; ver deuda explícita del plan).
const reviews: { quote: string; name: string; place: string }[] = [
  {
    quote:
      'Coordiné todo por WhatsApp y me respondieron el mismo día. El producto llegó rápido y tal como me explicaron.',
    name: 'María G.',
    place: 'Villa María del Triunfo',
  },
  {
    quote:
      'Me asesoraron sobre la talla antes de comprar. La atención fue clara y el producto cumplió con lo esperado.',
    name: 'Rosa L.',
    place: 'San Juan de Lurigancho',
  },
  {
    quote:
      'Fui al centro y me atendieron con paciencia, explicándome el uso del producto paso a paso.',
    name: 'Carmen P.',
    place: 'Santiago de Surco',
  },
];

const faqs = [
  {
    q: '¿Atienden con cita previa?',
    a: 'Puedes visitarnos en el horario indicado o coordinar tu evaluación por WhatsApp para que te atiendan sin esperas.',
  },
  {
    q: '¿Realizan envíos?',
    a: 'Sí, coordinamos envíos. Consúltanos por WhatsApp para verificar cobertura, costos y tiempos.',
  },
  {
    q: '¿Cómo elijo la talla correcta?',
    a: 'Te recomendamos medir antes de comprar y consultar tus dudas por WhatsApp; en los productos con evaluación, el personal te orienta personalmente.',
  },
];
---

<BaseLayout {site} {legal} {title} {description} schemas={[faqSchema(faqs)]}>
  <Hero
    title="Vuelve a moverte con total libertad y confianza."
    text="Diseñamos y seleccionamos soluciones ortopédicas de grado biomecánico para aliviar la sobrecarga, corregir tu postura y devolverte la seguridad en cada paso."
    image={heroImage}
    mobileImage={heroMobileImage}
    favorites={heroFavorites}
  >
    <Button href="/catalogo/" variant="primaryDark">Ver soluciones ortopédicas</Button>
  </Hero>
  <FeaturedCategories categories={categories} />
  <ServicesGrid {services} />
  <WhyUs />
  <HowItWorks {steps} />
  <Testimonials {reviews} />
  <Team />
  <TrustBar items={trustItems} />
  <Faq items={faqs} />
  <LocationCta {site} />
  <CtaBand
    {site}
    title="¿Necesitas ayuda para elegir?"
    text="Cuéntanos tu caso y te orientamos sobre el producto y la talla que necesitas."
    message={generalWhatsappMessage()}
  />
  <!-- Modal de promoción al final de la página (posición no afecta al <dialog> modal). -->
  <PromoModal />
</BaseLayout>
