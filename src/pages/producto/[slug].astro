---
import { api } from '../../api';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import ProductGallery from '../../components/product/ProductGallery.astro';
import ProductInfo from '../../components/product/ProductInfo.astro';
import ProductSpecs from '../../components/product/ProductSpecs.astro';
import RelatedProducts from '../../components/product/RelatedProducts.astro';
import ProductLegal from '../../components/legal/ProductLegal.astro';
import StickyProductBar from '../../components/product/StickyProductBar.astro';
import { breadcrumbSchema, productSchema, faqSchema } from '../../lib/schema';
import { productWhatsappMessage } from '../../data/whatsapp';
import { LEGAL } from '../../data/site';
import Container from '../../components/ui/Container.astro';
import { absUrl } from '../../lib/url';

export async function getStaticPaths() {
  // api.products.list() solo devuelve productos publicables (con registro sanitario).
  // Si un producto apunta a una categoría inexistente, no genera ruta.
  const products = await api.products.list();
  const paths = await Promise.all(
    products.map(async (product) => {
      const category = await api.categories.bySlug(product.category);
      if (!category) return [];
      return [
        {
          params: { slug: product.slug },
          props: { product, category, related: await api.products.related(product.slug) },
        },
      ];
    }),
  );
  return paths.flat();
}

const { product, category, related } = Astro.props;
const { name, seoTitle, seoDescription, description, images, price, availability, sku, brand, faq, specs } = product;

const pageUrl = absUrl(Astro.url.pathname);

// OG 1200×630 a partir de la primera imagen del producto
const ogImage = await getImage({ src: images[0].src, width: 1200, height: 630, format: 'jpg' });
const imageUrls = await Promise.all(
  images.map(
    async (i) => absUrl((await getImage({ src: i.src, width: 1200, format: 'jpg' })).src),
  ),
);

const crumbs = [
  { name: 'Inicio', href: '/' },
  { name: category.name, href: `/catalogo/${category.slug}/` },
  { name },
];
---
<BaseLayout
  title={seoTitle ?? name}
  description={seoDescription ?? description}
  image={ogImage.src}
  type="product"
  hideFloatingCta
  schemas={[
    breadcrumbSchema(crumbs.map((c) => ({ name: c.name, url: absUrl(c.href ?? Astro.url.pathname) }))),
    productSchema({
      name,
      description: seoDescription ?? description,
      images: imageUrls,
      url: pageUrl,
      sku,
      brand,
      price,
      availability,
      // condition ya viene tipado como vocabulario restringido (src/data/types.ts)
      condition: product.condition,
    }),
    ...(faq ? [faqSchema(faq)] : []),
  ]}
>
  <Breadcrumbs items={crumbs} />

  <section class="py-8">
    <Container>
      <div class="grid gap-8 md:grid-cols-2">
        <ProductGallery images={images} />
        <ProductInfo
          {name}
          {price}
          {availability}
          whatsappMessage={productWhatsappMessage(name, pageUrl)}
          registroSanitario={product.registroSanitario}
          claseRiesgo={product.claseRiesgo}
        />
      </div>

      <section class="py-8">
        <h2 class="font-display text-2xl font-semibold text-ink">Descripción</h2>
        <p class="mt-6 max-w-prose text-neutral">{description}</p>
      </section>

      {specs && <ProductSpecs specs={specs} />}

      <RelatedProducts products={related} />

      <ProductLegal
        registroSanitario={product.registroSanitario}
        claseRiesgo={product.claseRiesgo}
        titularRegistro={product.titularRegistro}
        priceIncludesIGV={LEGAL.pricesIncludeIGV}
      />
    </Container>
  </section>

  {/* §6.4: barra fija solo móvil; el flotante global queda oculto en esta página. */}
  <StickyProductBar
    {name}
    {price}
    whatsappMessage={productWhatsappMessage(name, pageUrl)}
  />
</BaseLayout>
