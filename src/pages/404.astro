---
import BaseLayout from '../layouts/BaseLayout.astro';
import { api } from '../api';
import Container from '../components/ui/Container.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import CategoryChips from '../components/catalog/CategoryChips.astro';
import Button from '../components/ui/Button.astro';
import { whatsappLink, generalWhatsappMessage } from '../data/whatsapp';

// Página de error: no se indexa y ofrece rutas reales para recuperarse.
const title = 'Página no encontrada';
const description = 'La página que busca no existe. Vuelva al inicio o explore el catálogo.';
const categories = await api.categories.list();
---

<BaseLayout {title} {description} noindex>
  <article class="pb-16">
    <Container size="narrow">
      <PageHeader
        title="Página no encontrada"
        lead="El enlace que siguió no corresponde a ninguna página del sitio. Puede volver al inicio o explorar nuestras categorías:"
      />
      <div class="mt-6">
        <CategoryChips categories={categories} />
      </div>
      <div class="mt-6 flex flex-wrap gap-3">
        <Button href="/">Volver al inicio</Button>
        <Button
          href={whatsappLink(generalWhatsappMessage())}
          variant="outline"
          eventName="whatsapp_click"
        >
          Escribir por WhatsApp
        </Button>
      </div>
    </Container>
  </article>
</BaseLayout>
