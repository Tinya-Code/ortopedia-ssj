---
// mejoras.md §5.10 — banda de cierre reutilizable (home y categoría, M6).
// Texto blanco puro sobre bg-primary: white/85 no llega a AA (4.85:1 solo con blanco).
import Container from './Container.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import type { Site } from '../../api/types';

interface Props {
  /** Número de WhatsApp — lo baja quien monta la banda. */
  site: Site;
  title: string;
  text?: string;
  message: string;
}
const { site, title, text, message } = Astro.props;
---
<section class="bg-primary py-12 text-white md:py-16">
  <Container>
    <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <div class="max-w-prose">
        <h2 class="font-display text-h2 md:text-h2-lg font-semibold">{title}</h2>
        {text && <p class="mt-3 text-white">{text}</p>}
      </div>
      <WhatsAppButton {site} variant="white" {message} label="Escribir por WhatsApp" />
    </div>
  </Container>
</section>
