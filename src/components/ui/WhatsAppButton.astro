---
import { whatsappLink } from '../../lib/whatsapp';

interface Props {
  message: string;
  label?: string;
  variant?: 'primary' | 'floating' | 'white';
  eventName?: string; // para analytics
}
const {
  message,
  label = 'Consultar por WhatsApp',
  variant = 'primary',
  eventName = 'whatsapp_click',
} = Astro.props;
const href = whatsappLink(message);
---
<a
  href={href}
  class:list={[
    variant === 'primary'
      ? 'inline-flex items-center gap-2 rounded-lg bg-[#25d366] px-5 py-3 text-sm font-semibold text-white hover:bg-[#1ebe5b]'
      : variant === 'white'
        ? 'inline-flex items-center gap-2 rounded-lg bg-white px-5 py-3 text-sm font-semibold text-primary hover:bg-neutral/10'
        : 'fixed bottom-4 right-4 z-50 inline-flex items-center gap-2 rounded-full bg-[#25d366] px-5 py-3 text-sm font-semibold text-white shadow-lg hover:bg-[#1ebe5b]',
  ]}
  target="_blank"
  rel="noopener noreferrer"
  data-event={eventName}
  aria-label={label}
>
  <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
    <path d="M12 2a10 10 0 0 0-8.6 15l-1.4 5 5.1-1.3A10 10 0 1 0 12 2Zm5.2 14.2c-.2.6-1.3 1.1-1.8 1.2-.5.1-1.1.1-1.8-.1a12 12 0 0 1-5.2-4.1c-.4-.5-1.3-1.8-1.3-3s.6-1.7.9-2c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2 0 .4-.1.5l-.4.5c-.1.1-.3.3-.1.6.6 1 1.4 1.8 2.4 2.3.3.2.5.1.6-.1l.7-.9c.2-.2.4-.2.6-.1l1.9.9c.2.1.4.2.4.3.1.2.1.7-.1 1.3Z" />
  </svg>
  <span>{label}</span>
</a>
