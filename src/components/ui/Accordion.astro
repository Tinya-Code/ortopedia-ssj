---
// mejoras.md §5.6 — acordeón nativo sin JS: <details>/<summary> + chevron CSS
// que rota con group-open. Mismo contrato de datos que el JSON-LD FAQPage que
// arma la página, así HTML visible y schema siguen coincidiendo.
import ChevronDown from '../icons/ChevronDown.astro';

interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---
<div class="divide-y divide-neutral/20 border-y border-neutral/20">
  {items.map((it) => (
    <details class="group">
      <summary
        class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 py-3 text-sm font-semibold text-ink [&::-webkit-details-marker]:hidden"
      >
        {it.q}
        <ChevronDown
          class="size-5 shrink-0 text-primary transition-transform group-open:rotate-180"
        />
      </summary>
      <div class="pb-4 pr-8 text-neutral">{it.a}</div>
    </details>
  ))}
</div>
