---
// mejoras.md §5.9 — CTA de compra siempre a mano en móvil (ficha de producto).
// Regla de la spec: en esta página el flotante global queda oculto en móvil
// (BaseLayout `hideFloatingCta` → `hidden md:flex`) para no superponer dos CTA
// fijos; el body lleva `pb-24 md:pb-0` para que la barra no tape el final.
import Button from '../ui/Button.astro';
import WhatsAppButton from '../ui/WhatsAppButton.astro';
import PriceTag from '../ui/PriceTag.astro';
import type { Site } from '../../api/types';
import type { Product as CartProduct } from '@dennismiranda/astro-cart/core';

interface Props {
  /** Número de WhatsApp del negocio — lo baja la ficha de producto. */
  site: Site;
  name: string;
  /** null = cotiza, sin precio publicado (PriceTag muestra "Consultar precio"). */
  price: number | null;
  whatsappMessage: string;
  /** Payload del carrito; null = no agregable (sin precio o sin stock). */
  cartProduct?: CartProduct | null;
}
const { site, name, price, whatsappMessage, cartProduct = null } = Astro.props;
---
<aside
  aria-label="Compra rápida"
  class="fixed inset-x-0 bottom-0 z-40 border-t border-neutral/20 bg-white px-4 py-3 shadow-lg md:hidden"
>
  <div class="flex items-center gap-3">
    <div class="min-w-0 flex-1">
      <p class="truncate text-sm font-semibold text-ink">{name}</p>
      <PriceTag {price} class="mt-0.5" />
    </div>
    <div class="flex shrink-0 items-center gap-2">
      {cartProduct && (
        <div data-cart-product data-id={cartProduct.id} data-product={JSON.stringify(cartProduct)}>
          <Button
            type="button"
            data-cart-action="add"
            variant="primary"
            size="md"
          >
            Agregar
          </Button>
        </div>
      )}
      <WhatsAppButton
        {site}
        message={whatsappMessage}
        label="Consultar"
        eventName="whatsapp_product"
      />
    </div>
  </div>
</aside>
