---
interface Props {
  // api.js es JS sin anotaciones: TS infiere uniones con claves opcionales
  specs: Record<string, string | undefined>;
}
const { specs } = Astro.props;
const entries = Object.entries(specs);
---
{entries.length > 0 && (
  <section class="mt-10">
    <h2 class="font-display text-h2 md:text-h2-lg font-semibold text-ink">Especificaciones</h2>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full border-collapse text-left">
        <thead>
          <tr class="sr-only">
            <th scope="col">Característica</th>
            <th scope="col">Detalle</th>
          </tr>
        </thead>
        <tbody class="border-y border-neutral/20">
          {entries.map(([k, v]) => (
            <tr class="odd:bg-neutral/5">
              <th scope="row" class="w-1/3 py-3 pr-4 align-top font-semibold text-ink">{k}</th>
              <td class="py-3 align-top text-neutral">{v}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
)}
