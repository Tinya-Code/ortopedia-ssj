---
interface Props {
  // api.js es JS sin anotaciones: TS infiere uniones con claves opcionales
  specs: Record<string, string | undefined>;
}
const { specs } = Astro.props;
const entries = Object.entries(specs);
---
{entries.length > 0 && (
  <section class="mt-10">
    <h2 class="font-display text-2xl font-semibold">Especificaciones</h2>
    <dl class="mt-4 divide-y divide-neutral/20 border-y border-neutral/20">
      {entries.map(([k, v]) => (
        <div class="grid gap-1 py-3 sm:grid-cols-3">
          <dt class="font-semibold text-primary">{k}</dt>
          <dd class="text-neutral sm:col-span-2">{v}</dd>
        </div>
      ))}
    </dl>
  </section>
)}
