---
// mejoras.md §5.12 — sello "Registro sanitario N · Clase II" junto al precio.
// Dato factual de la ficha; sin promesas clínicas. Oculto si el producto no
// tiene registro (centinela '' en el catálogo; '' es falsy en el guard).
import { icons } from '../icons/index';

interface Props {
  registroSanitario: string;
  /** '' = sin clase publicada; no se muestra el tramo "· Clase". */
  claseRiesgo: string;
}
const { registroSanitario, claseRiesgo } = Astro.props;

// Icono decorativo (aria-hidden interno) como señal de valor junto al precio.
const StarIcon = icons.star;
---
<p
  class="mt-3 inline-flex items-center gap-1.5 rounded-full border border-success/30 bg-success/5 px-3 py-1 text-xs font-semibold text-success"
>
  <StarIcon class="h-4 w-4 shrink-0" />
  Registro sanitario {registroSanitario}
  {claseRiesgo && <>· Clase {claseRiesgo}</>}
</p>
