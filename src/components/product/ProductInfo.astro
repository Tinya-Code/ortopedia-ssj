---
// Orden de la ficha (mejoras.md §6.4): h1 → precio lg → disponibilidad →
// registro sanitario → CTA → bloque de envío/cambios.
// `self-start md:sticky md:top-24` mantiene la columna derecha visible en desktop
// (top-24 deja pasar el header sticky de h-16).
import Button from '../ui/Button.astro';
import WhatsAppButton from '../ui/WhatsAppButton.astro';
import AvailabilityBadge from './AvailabilityBadge.astro';
import RegistroBadge from './RegistroBadge.astro';
import PriceTag from '../ui/PriceTag.astro';
import { icons } from '../icons/index';
import type { Site } from '../../api/types';
import type { Product as CartProduct } from '@dennismiranda/astro-cart/core';

interface Props {
  /** Número de WhatsApp del negocio — lo baja la ficha de producto. */
  site: Site;
  name: string;
  /** null = cotiza, sin precio publicado (PriceTag muestra "Consultar precio"). */
  price: number | null;
  availability: string;
  whatsappMessage: string;
  /** '' = sin registro; el badge se oculta porque '' es falsy. */
  registroSanitario: string;
  /** '' = sin clase de riesgo; no se muestra el tramo "· Clase". */
  claseRiesgo: string;
  /** Payload del carrito; null = no agregable (sin precio o sin stock). */
  cartProduct?: CartProduct | null;
}
const {
  site,
  name,
  price,
  availability,
  whatsappMessage,
  registroSanitario,
  claseRiesgo,
  cartProduct = null,
} = Astro.props;

// Iconos decorativos (aria-hidden interno) del bloque de confianza.
const TruckIcon = icons.truck;
const RotateCcwIcon = icons['rotate-ccw'];
---
<section class="self-start md:sticky md:top-24">
  <h1 class="font-display text-h1 md:text-h1-lg font-semibold text-ink">{name}</h1>

  <PriceTag price={price} size="lg" class="mt-4" />

  <div class="mt-3">
    <AvailabilityBadge availability={availability} />
  </div>

  {registroSanitario && <RegistroBadge {registroSanitario} {claseRiesgo} />}

  {cartProduct ? (
    <div class="mt-5 flex flex-col gap-3 md:flex-row">
      <div data-cart-product data-id={cartProduct.id} data-product={JSON.stringify(cartProduct)}>
        <Button
          type="button"
          data-cart-action="add"
          variant="primary"
          class="w-full justify-center md:w-auto"
        >
          Agregar
        </Button>
      </div>
      <WhatsAppButton
        {site}
        message={whatsappMessage}
        label="Consultar por WhatsApp"
        variant="outline"
        eventName="whatsapp_product"
        class="w-full justify-center md:w-auto"
      />
    </div>
  ) : (
    <div class="mt-5">
      <WhatsAppButton
        {site}
        message={whatsappMessage}
        label="Pedir por WhatsApp"
        eventName="whatsapp_product"
        class="w-full justify-center md:w-auto"
      />
    </div>
  )}

  {/* Confianza bajo el CTA: envío y cambios, sin cifras ni plazos inventados.
      El enlace hereda el foco visible global (:focus-visible en global.css). */}
  <div class="mt-5 flex flex-col gap-2 text-sm text-neutral">
    <p class="flex items-center gap-2">
      <TruckIcon class="h-4 w-4 shrink-0" />
      <span>Envío a coordinar por WhatsApp.</span>
    </p>
    <p class="flex items-center gap-2">
      <RotateCcwIcon class="h-4 w-4 shrink-0" />
      <span>Cambios y devoluciones: <a href="/cambios-y-devoluciones/" class="text-primary underline underline-offset-4">ver condiciones</a>.</span>
    </p>
  </div>
</section>
