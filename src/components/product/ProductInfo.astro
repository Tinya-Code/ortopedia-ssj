---
// Orden de la ficha (mejoras.md §6.4): h1 → badge → precio lg → aviso IGV → CTA.
// `self-start md:sticky md:top-24` mantiene la columna derecha visible en desktop
// (top-24 deja pasar el header sticky de h-16).
import WhatsAppButton from '../ui/WhatsAppButton.astro';
import AvailabilityBadge from './AvailabilityBadge.astro';
import RegistroBadge from './RegistroBadge.astro';
import PriceTag from '../ui/PriceTag.astro';
import { LEGAL } from '../../data/site';
import type { Product as CartProduct } from '@dennismiranda/astro-cart/core';

interface Props {
  name: string;
  price?: number;
  availability: string;
  whatsappMessage: string;
  registroSanitario?: string;
  claseRiesgo?: string;
  /** Payload del carrito; null = no agregable (sin precio o sin stock). */
  cartProduct?: CartProduct | null;
}
const {
  name,
  price,
  availability,
  whatsappMessage,
  registroSanitario,
  claseRiesgo,
  cartProduct = null,
} = Astro.props;

// legal.md 8.3: la ficha debe aclarar que el precio final incluye IGV y demás cargos.
const igvNote = LEGAL.pricesIncludeIGV
  ? 'El precio final incluye IGV y demás cargos.'
  : 'El precio final no incluye IGV ni demás cargos.';
---
<section class="self-start md:sticky md:top-24">
  <h1 class="font-display text-3xl font-semibold text-ink">{name}</h1>

  <div class="mt-4">
    <AvailabilityBadge availability={availability} />
  </div>

  <PriceTag price={price} size="lg" includesIGV={LEGAL.pricesIncludeIGV} class="mt-3" />

  <p class="mt-1 text-sm text-neutral">{igvNote}</p>

  {registroSanitario && <RegistroBadge {registroSanitario} {claseRiesgo} />}

  {/* CTA: agregar al carrito (primario) + WhatsApp (outline). Sin precio/stock
      se mantiene únicamente el CTA de WhatsApp. */}
  {cartProduct ? (
    <div class="mt-5 flex flex-col gap-3 [&_a]:w-full [&_a]:justify-center md:[&_a]:w-auto">
      <div data-cart-product data-id={cartProduct.id} data-product={JSON.stringify(cartProduct)}>
        <button
          type="button"
          data-cart-action="add"
          class="inline-flex w-full items-center justify-center rounded-lg bg-primary px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-primary/90 motion-reduce:transition-none md:w-auto"
        >
          Añadir al carrito
        </button>
      </div>
      <WhatsAppButton
        message={whatsappMessage}
        label="Consultar por WhatsApp"
        variant="outline"
        eventName="whatsapp_product"
      />
    </div>
  ) : (
    <div class="mt-5 [&>a]:w-full [&>a]:justify-center md:[&>a]:w-auto">
      <WhatsAppButton message={whatsappMessage} label="Pedir por WhatsApp" eventName="whatsapp_product" />
    </div>
  )}
</section>
