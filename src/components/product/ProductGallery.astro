---
// Galería de la ficha de producto (plan F2 — mejoras de galería):
// - Zoom hover en desktop: CSS puro (md:group-hover:scale-105 dentro de un
//   contenedor con overflow-hidden). No genera scroll horizontal en mobile
//   porque el contenedor recorta la escala.
// - Lightbox accesible con <dialog> nativo (sin dependencias): al activar el
//   botón de la imagen principal se abre la vista ampliada; se cierra con
//   Escape (gestionado por el navegador), con la X o con clic fuera. El
//   navegador restaura el foco al botón trigger al cerrar.
// - Miniaturas con proporción uniforme 4:5 (aspect-[4/5] + 160×200 intrínseco
//   vía astro:assets) para que el carruel mantenga alturas iguales.
// Los iconos provienen del registro (src/components/icons/index.ts); el foco
// visible hereda :focus-visible de global.css.
import { Image } from "astro:assets";
import { imageSrc } from "../../lib/image";
import { icons } from "../icons/index";

interface Props {
  images: { src: ImageMetadata | string; alt: string }[];
}
const { images } = Astro.props;

const SearchIcon = icons.search;
const XIcon = icons.x;
---

<div data-gallery-root>
  {
    /* El botón envuelve la imagen principal: enfocable con teclado, foco visible
      global y cursor-zoom-in como señal de affordance. El borde y el redondeo
      viven en el botón (no en la imagen) para que el zoom quede recortado por
      overflow-hidden sin escalar el borde. */
  }
  <button
    type="button"
    data-gallery-open
    aria-label="Ampliar imagen"
    class="group relative flex aspect-square w-full cursor-zoom-in items-center justify-center overflow-hidden rounded-xl border border-neutral/20 bg-white p-4"
  >
    <Image
      src={imageSrc(images[0].src)}
      alt={images[0].alt}
      width={800}
      height={800}
      fit="contain"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      format="webp"
      class="h-full w-full object-contain transition-transform duration-300 motion-reduce:transition-none md:group-hover:scale-105"
    />

    <span
      aria-hidden="true"
      class="pointer-events-none absolute bottom-3 right-3 hidden h-9 w-9 items-center justify-center rounded-full bg-ink/60 text-light opacity-0 transition-opacity duration-300 group-hover:opacity-100 motion-reduce:transition-none md:flex"
    >
      <SearchIcon class="h-5 w-5" />
    </span>
  </button>

  {
    /* Lightbox nativo: preflight de Tailwind anula margin/border del UA del
      <dialog>, por eso se restaura m-auto (centrado) y el fondo del backdrop
      con [&::backdrop]. Escape lo cierra el navegador (evento cancel nativo). */
  }
  <dialog
    aria-label="Vista ampliada de la imagen"
    data-gallery-dialog
    class="m-auto max-h-[90dvh] w-fit max-w-[92vw] border-0 bg-transparent p-0 [&::backdrop]:bg-ink/80"
  >
    <div class="relative flex max-h-[90dvh] items-center justify-center">
      <Image
        src={imageSrc(images[0].src)}
        alt={images[0].alt}
        width={1200}
        height={1200}
        fit="contain"
        loading="lazy"
        decoding="async"
        format="webp"
        class="max-h-[80dvh] w-auto max-w-[92vw] rounded-xl bg-white object-contain"
      />
      <button
        type="button"
        data-gallery-close
        aria-label="Cerrar"
        class="absolute right-3 top-3 flex h-10 w-10 items-center justify-center rounded-full bg-ink/70 text-light transition-colors hover:bg-ink"
      >
        <XIcon class="h-5 w-5" />
      </button>
    </div>
  </dialog>

  {
    /* Con UNA sola imagen no se renderiza el carruel (guard preservado).
      shrink-0 evita que los ítems se compriman y rompan la proporción 4:5
      cuando hay varias miniaturas en pantallas angostas. */
  }
  {
    images.length > 1 && (
      <ul class="mt-3 flex gap-3 overflow-x-auto" role="list">
        {images.slice(1).map((img) => (
          <li>
            <Image
              src={imageSrc(img.src)}
              alt={img.alt}
              width={160}
              height={200}
              fit="contain"
              loading="lazy"
              decoding="async"
              format="webp"
              class="aspect-[4/5] h-24 w-auto shrink-0 rounded-lg border border-neutral/20 bg-white object-contain"
            />
          </li>
        ))}
      </ul>
    )
  }
</div>

<script>
  // Lightbox sin dependencias: listener por trigger; el diálogo se resuelve
  // desde el contenedor común [data-gallery-root] para no acoplar por IDs
  // (el script se inyecta una sola vez por página aunque el componente
  // se use más de una vez).
  document
    .querySelectorAll<HTMLButtonElement>("[data-gallery-open]")
    .forEach((trigger) => {
      const dialog = trigger
        .closest("[data-gallery-root]")
        ?.querySelector<HTMLDialogElement>("[data-gallery-dialog]");
      if (!(dialog instanceof HTMLDialogElement)) return;

      trigger.addEventListener("click", () => dialog.showModal());
      dialog
        .querySelector("[data-gallery-close]")
        ?.addEventListener("click", () => dialog.close());
      // Clic en el backdrop: el evento apunta al propio <dialog> (p-0, así que el
      // área del diálogo es exactamente el contenido; fuera de él target === dialog).
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
    });
</script>
