---
// mejoras.md §5.4 — pastilla de disponibilidad SIEMPRE con texto (no solo color)
// y derivada del mismo `availability` que alimenta el JSON-LD (coherencia oferta).
interface Props {
  availability: string;
}
const { availability } = Astro.props;

const badges = {
  InStock: { text: 'En stock', cls: 'bg-success/10 text-success' },
  PreOrder: { text: 'Por encargo', cls: 'bg-warning/10 text-warning' },
  OutOfStock: { text: 'Agotado', cls: 'bg-danger/10 text-danger' },
} as const;

const badge =
  badges[availability as keyof typeof badges] ?? { text: availability, cls: 'bg-neutral/10 text-neutral' };
---
<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-sm font-semibold',
    badge.cls,
  ]}
>
  <span aria-hidden="true" class="h-2 w-2 rounded-full bg-current"></span>
  {badge.text}
</span>
