---
import { Image } from 'astro:assets';
import AvailabilityBadge from '../product/AvailabilityBadge.astro';
import PriceTag from '../ui/PriceTag.astro';

// Slice mínimo que consume la tarjeta (ISP): no el objeto entero.
interface Props {
  product: {
    slug: string;
    name: string;
    price?: number;
    availability: string;
    images: { src: ImageMetadata; alt: string }[];
  };
  priority?: boolean; // los 4 primeros se cargan con eager
}
const { product, priority = false } = Astro.props;
const { slug, name, price, availability, images } = product;
---
<article class="rounded-xl border border-neutral/20 p-4">
  <a href={`/producto/${slug}/`} class="relative block">
    <Image
      src={images[0].src}
      alt={images[0].alt}
      width={400}
      height={400}
      loading={priority ? 'eager' : 'lazy'}
      decoding="async"
      format="webp"
      class="aspect-square w-full rounded-lg object-cover"
    />
    {/* Funda blanca: la pastilla usa fondo con 10% de opacidad y sobre la foto
        perdería contraste (AA). */}
    <span class="absolute left-2 top-2 rounded-full bg-white/90 p-0.5">
      <AvailabilityBadge availability={availability} />
    </span>
    <h2 class="mt-3 font-display text-lg font-semibold text-ink">{name}</h2>
  </a>
  <PriceTag price={price} class="mt-1" />
</article>
