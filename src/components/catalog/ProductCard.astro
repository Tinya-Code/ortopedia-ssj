---
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import PriceTag from '../ui/PriceTag.astro';
import WhatsAppButton from '../ui/WhatsAppButton.astro';
import AvailabilityBadge from '../product/AvailabilityBadge.astro';
import { imageSrc } from '../../lib/image';
import { productWhatsappMessage } from '../../lib/whatsapp';
import { absUrl } from '../../lib/url';
import { isAddable, toCartProduct } from '../../lib/cart';
import type { Product } from '../../api/types';

// Slice mínimo que consume la tarjeta (ISP): no el objeto entero.
interface Props {
  product: {
    slug: string;
    name: string;
    /** null = cotiza, sin precio publicado. */
    price: number | null;
    seoDescription?: string;
    sku?: string;
    availability?: Product['availability'];
    images: { src: ImageMetadata | string; alt: string }[];
  };
  priority?: boolean; // los 4 primeros se cargan con eager
  /** Versión reducida (p. ej. productos relacionados). */
  compact?: boolean;
  /** Etiqueta del título: h2 en el catálogo, h3 dentro de otra sección con h2. */
  titleTag?: 'h2' | 'h3';
}
const { product, priority = false, compact = false, titleTag = 'h2' } = Astro.props;
const Heading = titleTag;
const { slug, name, price, seoDescription, images } = product;
const href = `/producto/${slug}/`;

// Con precio publicado y stock real el CTA agrega al carrito (@dennismiranda/astro-cart);
// si no, se mantiene la consulta por WhatsApp.
const addable = isAddable({ price: price ?? 0, availability: product.availability ?? 'InStock' });
const cartProduct = addable
  ? toCartProduct({
      slug,
      name,
      price: price ?? 0,
      availability: 'InStock',
      sku: product.sku ?? slug,
      seoDescription,
      image: images[0],
    })
  : null;

const availability = product.availability ?? 'InStock';
---
<article
  class:list={[
    'flex flex-col rounded-xl border border-slate-100 bg-light transition-all duration-200 hover:border-slate-200 hover:shadow-md motion-reduce:transition-none',
    compact ? 'p-3' : 'p-4',
  ]}
  data-cart-product={cartProduct ? '' : undefined}
  data-id={cartProduct ? slug : undefined}
  data-product={cartProduct ? JSON.stringify(cartProduct) : undefined}
>
  <a href={href} class="block">
    <div
      class:list={[
        'flex items-center justify-center overflow-hidden rounded-lg bg-white',
        compact ? 'h-32' : 'h-44 sm:h-48',
      ]}
    >
      <Image
        src={imageSrc(images[0].src)}
        alt={images[0].alt}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
        decoding="async"
        format="webp"
        class="h-full w-full object-contain"
      />
    </div>
    <Heading
      class:list={[
        'line-clamp-1 font-semibold text-ink',
        compact ? 'mt-3 text-sm' : 'mt-4 text-base',
      ]}
    >
      {name}
    </Heading>
    {!compact && seoDescription && (
      <p class="mt-1 line-clamp-2 text-xs leading-relaxed text-neutral">{seoDescription}</p>
    )}
  </a>
  <div class="mt-auto">
    {price != null && (
      <PriceTag
        price={price}
        size={compact ? 'md' : 'card'}
        class={compact ? 'mt-2' : 'mt-3'}
      />
    )}
    {/* Disponibilidad con el badge canónico (mejoras.md §5.4: pastilla con
        texto, el color nunca va solo) — misma pieza que la ficha de producto. */}
    <div class="mt-1.5">
      <AvailabilityBadge {availability} />
    </div>
    {cartProduct ? (
      <Button
        type="button"
        data-cart-action="add"
        variant="primary"
        size={compact ? 'sm' : 'md'}
        class="mt-3 w-full"
      >
        Agregar
      </Button>
    ) : (
      <WhatsAppButton
        message={productWhatsappMessage(name, absUrl(href))}
        label={price ? 'Pedir por WhatsApp' : 'Consultar precio'}
        eventName="whatsapp_product"
        variant="primary"
        class="mt-3 w-full"
      />
    )}
  </div>
</article>
