---
import { Image } from 'astro:assets';
import PriceTag from '../ui/PriceTag.astro';
import { imageSrc } from '../../lib/image';
import { productWhatsappMessage, whatsappLink } from '../../data/whatsapp';
import { absUrl } from '../../lib/url';
import { isAddable, toCartProduct } from '../../lib/cart';
import type { Product } from '../../data/types';

// Slice mínimo que consume la tarjeta (ISP): no el objeto entero.
interface Props {
  product: {
    slug: string;
    name: string;
    price?: number;
    seoDescription?: string;
    sku?: string;
    availability?: Product['availability'];
    images: { src: ImageMetadata | string; alt: string }[];
  };
  priority?: boolean; // los 4 primeros se cargan con eager
}
const { product, priority = false } = Astro.props;
const { slug, name, price, seoDescription, images } = product;
const href = `/producto/${slug}/`;
const orderHref = whatsappLink(productWhatsappMessage(name, absUrl(href)));

// Con precio publicado y stock real el CTA agrega al carrito (@dennismiranda/astro-cart);
// si no, se mantiene la consulta por WhatsApp.
const addable = isAddable({ price: price ?? 0, availability: product.availability ?? 'InStock' });
const cartProduct = addable
  ? toCartProduct({
      slug,
      name,
      price: price!,
      availability: 'InStock',
      sku: product.sku ?? slug,
      seoDescription,
      image: images[0],
    })
  : null;
---
<article
  class="flex flex-col rounded-xl border border-slate-100 bg-light p-4 transition-all duration-200 hover:border-slate-200 hover:shadow-md motion-reduce:transition-none"
  data-cart-product={cartProduct ? '' : undefined}
  data-id={cartProduct ? slug : undefined}
  data-product={cartProduct ? JSON.stringify(cartProduct) : undefined}
>
  <a href={href} class="block">
    <div class="flex h-44 items-center justify-center overflow-hidden rounded-lg bg-white sm:h-48">
      <Image
        src={imageSrc(images[0].src)}
        alt={images[0].alt}
        width={400}
        height={400}
        loading={priority ? 'eager' : 'lazy'}
        decoding="async"
        format="webp"
        class="h-full w-full object-contain"
      />
    </div>
    <h2 class="mt-4 line-clamp-1 text-base font-semibold text-ink">{name}</h2>
    {seoDescription && (
      <p class="mt-1 line-clamp-2 text-xs leading-relaxed text-neutral">{seoDescription}</p>
    )}
  </a>
  <div class="mt-auto">
    <PriceTag price={price} size="card" class="mt-3" />
    {cartProduct ? (
      <button
        type="button"
        data-cart-action="add"
        class="mt-3 block w-full rounded-lg bg-primary py-2.5 text-center text-sm font-medium text-white transition-colors hover:bg-primary/90 motion-reduce:transition-none"
      >
        Añadir al carrito
      </button>
    ) : (
      <a
        href={orderHref}
        target="_blank"
        rel="noopener noreferrer"
        data-event="whatsapp_product"
        class="mt-3 block w-full rounded-lg bg-primary py-2.5 text-center text-sm font-medium text-white transition-colors hover:bg-primary/90 motion-reduce:transition-none"
      >
        {price ? 'Pedir por WhatsApp' : 'Consultar precio'}
      </a>
    )}
  </div>
</article>
