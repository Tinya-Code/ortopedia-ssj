---
import { Image } from 'astro:assets';
import { imageSrc } from '../../lib/image';

interface Props {
  category: {
    slug: string;
    name: string;
    seoDescription: string;
    image: ImageMetadata | string;
    imageAlt: string;
  };
  titleTag?: 'h2' | 'h3';
  class?: string;
}
const { category, titleTag = 'h3', class: className = '' } = Astro.props;
const Heading = titleTag;
// `src` debe ser el ImageMetadata, no `.src`: si Astro recibe el string no puede
// transformar y entrega el jpg original ignorando `format`.
---
<article
  class:list={[
    'rounded-card border border-neutral/20 bg-white p-4 shadow-card transition hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md motion-reduce:transition-none',
    className,
  ]}
>
  <a href={`/catalogo/${category.slug}/`} class="group block">
    {/* Caja de imagen fija + object-contain: las imágenes de categoría son
        recortes de producto (ratios reales cuadrados/apaisados) — sin esto el
        default object-fit:fill las estiraba. Mismo tratamiento que ProductCard.
        Sin width/height forzados: Astro infiere del ImageMetadata. */}
    <div
      class="flex h-40 w-full items-center justify-center overflow-hidden rounded-lg bg-light sm:h-48"
    >
      <Image
        src={imageSrc(category.image)}
        alt={category.imageAlt}
        format="webp"
        loading="lazy"
        decoding="async"
        class="h-full w-full object-contain"
      />
    </div>
    <Heading class="mt-4 font-display text-lg font-semibold text-ink group-hover:underline">
      {category.name}
    </Heading>
    <p class="mt-1 text-sm text-neutral">{category.seoDescription}</p>
  </a>
</article>
