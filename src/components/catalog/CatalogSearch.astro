---
// Buscador global de productos (reutilizable).
// Solo presenta el markup: el comportamiento vive en src/scripts/catalog.ts
// y cada página lo inicializa con initCatalog().
import Button from '../ui/Button.astro';
---
<div class="flex items-center gap-2">
  <label for="catalog-search" class="sr-only">Buscar productos</label>
  <input
    id="catalog-search"
    type="search"
    autocomplete="off"
    placeholder="Buscar productos, marcas o categorías..."
    class="h-11 min-w-0 flex-1 rounded-lg border border-slate-400 bg-white px-4 text-sm text-ink transition-colors placeholder:text-neutral hover:border-slate-500 focus:border-primary focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none"
  />
  <Button
    type="button"
    id="catalog-search-btn"
    variant="primary"
    size="md"
  >
    Buscar
  </Button>
</div>
