---
// Destacados de la página de enlaces: enlaces con miniatura al catálogo.
// Es el único bloque con imagen: no explica ni vende, solo abre la ficha.
import { Image } from 'astro:assets';
import { imageSrc } from '../../lib/image';
import { icons } from '../icons/index';

interface Props {
  /** Slice mínimo que consume la lista (ISP), no la entidad entera. */
  featured: {
    slug: string;
    name: string;
    description?: string;
    seoDescription?: string;
    images: { src: ImageMetadata | string; alt: string }[];
  }[];
  title?: string;
}
const { featured, title = 'Destacados' } = Astro.props;
const ArrowRight = icons['arrow-right'];
---
{
  featured.length > 0 && (
    <section aria-labelledby="links-destacados">
      <h2 id="links-destacados" class="text-xs font-semibold uppercase tracking-[0.1em] text-neutral">
        {title}
      </h2>
      <ul class="mt-3 grid gap-3" role="list">
        {featured.map((p) => (
          <li>
            <a
              href={`/producto/${p.slug}/`}
              data-event="featured_link_click"
              class="flex items-center gap-3 rounded-xl border border-neutral/20 bg-white p-3 transition-colors hover:border-primary motion-reduce:transition-none"
            >
              <Image
                src={imageSrc(p.images[0].src)}
                alt={p.images[0].alt}
                width={96}
                height={96}
                format="webp"
                quality={85}
                class="size-16 shrink-0 rounded-lg bg-neutral/5 object-cover"
              />
              <span class="min-w-0 flex-1">
                <span class="block truncate text-sm font-semibold text-ink">{p.name}</span>
                <span class="mt-0.5 block line-clamp-2 text-xs leading-5 text-neutral">
                  {p.seoDescription ?? p.description}
                </span>
              </span>
              <ArrowRight class="size-4 shrink-0 text-neutral" />
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
