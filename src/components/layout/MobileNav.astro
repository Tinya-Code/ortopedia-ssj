---
// §5.13 — menú móvil sin JS: <details>/<summary>. El panel se posiciona contra el
// <header> (position: sticky crea contexto de posicionamiento), por eso queda
// a ancho completo aunque el <details> viva dentro del contenedor max-w-6xl.
import ReclamacionesLink from '../legal/ReclamacionesLink.astro';
import Menu from '../icons/Menu.astro';

interface Props {
  links: { href: string; label: string }[];
  currentPath: string;
}
const { links, currentPath } = Astro.props;
---
<details class="md:hidden">
  <summary
    class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-lg border border-neutral/20 [&::-webkit-details-marker]:hidden"
    aria-label="Abrir menú de navegación"
  >
    <Menu class="size-6" />
  </summary>
  <nav
    aria-label="Navegación principal"
    class="absolute left-0 right-0 top-16 border-b border-neutral/20 bg-white p-4 shadow-card"
  >
    <ul class="flex flex-col gap-y-1">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class:list={[
              'flex min-h-11 items-center rounded-lg px-3 text-sm',
              currentPath === l.href
                ? 'font-semibold text-primary'
                : 'text-neutral hover:text-primary',
            ]}
            aria-current={currentPath === l.href ? 'page' : undefined}
          >
            {l.label}
          </a>
        </li>
      ))}
      <li class="mt-2 border-t border-neutral/20 pt-3">
        <ReclamacionesLink />
      </li>
    </ul>
  </nav>
</details>
