---
import { SITE } from '../../data/site';
import { formatHours } from '../../lib/hours';
import LegalFooter from '../legal/LegalFooter.astro';

const year = new Date().getFullYear();
---
<footer class="mt-16 border-t border-neutral/20 bg-neutral/5 py-10">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 sm:grid-cols-2">
    <div class="text-sm text-neutral">
      <p class="font-display text-base font-semibold text-primary">{SITE.name}</p>
      <p class="mt-2">
        {SITE.address.street}, {SITE.address.city}<br />
        <a href={`tel:${SITE.phone.replace(/\s/g, '')}`} class="inline-flex min-h-11 items-center hover:text-primary">{SITE.phone}</a><br />
        <a href={`mailto:${SITE.email}`} class="inline-flex min-h-11 items-center hover:text-primary">{SITE.email}</a><br />
        Horario: {formatHours()}
      </p>
      <nav aria-label="Enlaces principales" class="mt-4 flex flex-wrap gap-x-4 gap-y-2">
        <a href="/" class="inline-flex min-h-11 min-w-11 items-center hover:text-primary">Inicio</a>
        <a href="/catalogo/" class="inline-flex min-h-11 min-w-11 items-center hover:text-primary">Catálogo</a>
        <a href="/#servicios" class="inline-flex min-h-11 min-w-11 items-center hover:text-primary">Servicios</a>
        <a href="/contacto/" class="inline-flex min-h-11 min-w-11 items-center hover:text-primary">Contacto</a>
      </nav>
    </div>

    <LegalFooter />
  </div>

  {/* Fila inferior (§3.4): el aviso IGV vive en LegalFooter, acá solo el ©. */}
  <div class="mx-auto mt-8 max-w-6xl px-4 text-sm text-neutral">
    <p>© {year} {SITE.name}</p>
  </div>
</footer>
