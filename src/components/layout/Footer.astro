---
import { Image } from "astro:assets";
// `site` baja del facade vía BaseLayout — el Footer no fija origen de datos.
import type { Site } from "../../api/types";
import logo from "../../assets/logo-ortopedia-solidaria-san-jose.png";
import Facebook from "../icons/Facebook.astro";
import Instagram from "../icons/Instagram.astro";
import TikTok from "../icons/TikTok.astro";
import ReclamacionesLink from "../legal/ReclamacionesLink.astro";

interface Props {
  site: Site;
}
const { site } = Astro.props;
const year = new Date().getFullYear();

const legalDocs = [
  { href: "/politica-de-privacidad/", label: "Política de privacidad" },
  { href: "/terminos-y-condiciones/", label: "Términos y condiciones" },
  { href: "/cambios-y-devoluciones/", label: "Cambios y devoluciones" },
];

const pages = [
  { href: "/", label: "Inicio" },
  { href: "/catalogo/", label: "Catálogo" },
  { href: "/#servicios", label: "Servicios" },
  { href: "/contacto/", label: "Contacto" },
];

const socials = [
  { href: site.social.facebook, label: "Facebook", Icon: Facebook },
  { href: site.social.tiktok, label: "TikTok", Icon: TikTok },
  { href: site.social.instagram, label: "Instagram", Icon: Instagram },
];
---

<footer class="mt-16 border-t border-neutral/20 bg-neutral/5">
  <div class="mx-auto grid max-w-6xl gap-6 px-4 py-10 sm:grid-cols-2">
    <div class="text-sm flex flex-col md:flex-row gap-6 text-neutral">
      <Image
        src={logo}
        alt=""
        width={200}
        height={200}
        format="webp"
        quality={90}
        class="h-40 w-40 my-auto mx-auto"
      />
      <div>
        <p class="mt-3 font-display text-lg font-semibold text-primary">
          {site.name}
        </p>
        <p class="mt-2">
          Productos ortopédicos de calidad, servicio personalizado y asesoría
          experta.
        </p>
        <ul class="mt-4 flex gap-1">
          {
            socials.map(({ href, label, Icon }) => (
              <li>
                <a
                  href={href}
                  class="inline-flex size-11 items-center justify-center text-neutral hover:text-primary"
                  aria-label={`${site.name} en ${label}`}
                  target="_blank"
                  rel="noopener"
                >
                  <Icon class="size-5" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="flex flex-col justify-end gap-8 sm:flex-row sm:gap-12">
      <nav aria-label="Explorar" class="text-sm text-neutral">
        <p class="text-xs font-semibold uppercase tracking-widest">Explorar</p>
        <ul class="mt-2 flex flex-col">
          {
            pages.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class="inline-flex min-h-11 items-center hover:text-primary"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Legal" class="text-sm text-neutral">
        <p class="text-xs font-semibold uppercase tracking-widest">Legal</p>
        <ul class="mt-2 flex flex-col">
          <li><ReclamacionesLink /></li>
          {
            legalDocs.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class="inline-flex min-h-11 items-center hover:text-primary"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>

  <div class="border-t border-neutral/20">
    <div
      class="mx-auto flex w-full justify-center px-4 py-5 text-sm text-neutral"
    >
      <p>© {year} {site.name}</p>
    </div>
  </div>
</footer>
