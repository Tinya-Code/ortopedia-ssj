---
// Usar SIEMPRE el mismo array que breadcrumbSchema para que HTML visible y
// JSON-LD coincidan (doc/seo.md §5).
interface Props {
  items: { name: string; href?: string }[];
}
const { items } = Astro.props;
---
<nav aria-label="Migas de pan" class="mx-auto max-w-6xl px-4 py-3 text-xs text-neutral sm:text-sm">
  {/* En móvil la tira scrollea horizontalmente en vez de partirse (mejoras.md §4).
     py-3/-my-3 da margen al área after: de los enlaces (≥44px) sin que el
     overflow-x del propio <ol> la recorte ni cambie la altura de la barra. */}
  <ol class="flex items-center gap-x-2 -my-3 overflow-x-auto whitespace-nowrap py-3 sm:flex-wrap sm:overflow-visible">
    {items.map((it, i) => (
      <li class="flex shrink-0 items-center gap-2">
        {i > 0 && <span aria-hidden="true">&gt;</span>}
        {it.href && i < items.length - 1 ? (
          <a
            href={it.href}
            class="relative after:absolute after:-inset-x-2 after:-inset-y-3 after:content-[''] hover:text-primary"
          >{it.name}</a>
        ) : (
          <span aria-current="page" class="text-neutral">{it.name}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
