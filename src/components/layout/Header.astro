---
import ReclamacionesLink from '../legal/ReclamacionesLink.astro';

// Nota: las páginas de servicio propias (/servicios/[slug]) no existen todavía;
// "Servicios" apunta a la sección de la home. Fase 4 debe renderizar la grilla de
// servicios con id="servicios" para que este enlace sea un ancla válida.
const links = [
  { href: '/', label: 'Inicio' },
  { href: '/catalogo/', label: 'Catálogo' },
  { href: '/#servicios', label: 'Servicios' },
  { href: '/contacto/', label: 'Contacto' },
];
const path = Astro.url.pathname;
---
<header class="border-b border-neutral/20 bg-white">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-4">
    <a href="/" class="font-display text-lg font-semibold text-primary">Centro Ortopédico SSJ</a>

    <nav aria-label="Navegación principal" class="flex flex-wrap items-center gap-x-5 gap-y-2">
      {links.map((l) => (
        <a
          href={l.href}
          class="text-sm text-neutral hover:text-primary"
          aria-current={path === l.href ? 'page' : undefined}
        >
          {l.label}
        </a>
      ))}
      <ReclamacionesLink />
    </nav>
  </div>
</header>
