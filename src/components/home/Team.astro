---
// PLACEHOLDER (autorizado por el usuario): foto de ejemplo y textos de identidad
// a nivel de equipo, sin nombres ni credenciales inventadas (mejorasui.md §6.1
// "quién está detrás": foto real + historia ≤150 palabras). Reemplazar cuando
// existan foto y datos reales del equipo.
import { Image } from 'astro:assets';
import teamImage from '../../assets/services/evaluacion-ortopedica.jpeg';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
---
<!-- PLACEHOLDER: foto y textos de identidad de ejemplo — reemplazar con datos reales del equipo -->
<section id="equipo" class="bg-white py-12 md:py-16">
  <Container>
    <div class="grid items-center gap-8 md:grid-cols-2 md:gap-12">
      <Image
        src={teamImage}
        alt="Ortopedista evaluando el pie de un paciente en el centro"
        width={640}
        height={480}
        format="webp"
        loading="lazy"
        decoding="async"
        class="h-64 w-full rounded-card object-cover md:h-96"
      />
      <div>
        <h2 class="font-display text-h2 md:text-h2-lg font-semibold text-ink">Quién está detrás de San Jose</h2>
        <p class="mt-4 text-neutral">
          Somos un equipo de ortopedistas y técnicos ortopédicos que atendemos en Villa María
          del Triunfo, ayudando a cada persona a encontrar la solución adecuada para su caso.
        </p>
        <p class="mt-3 text-neutral">
          La atención es personalizada: coordinamos tu evaluación por WhatsApp, tomamos tus
          medidas y te explicamos el uso correcto de cada producto.
        </p>
        <Button href="/servicios/" variant="outline" class="mt-6">Conocer nuestros servicios</Button>
      </div>
    </div>
  </Container>
</section>
