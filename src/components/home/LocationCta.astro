---
// NAP visible en HTML (texto, no solo dentro del iframe) + mapa con loading="lazy".
import type { Site } from '../../api/types';
import { formatHours } from '../../lib/hours';
import { generalWhatsappMessage } from '../../lib/whatsapp';
import WhatsAppButton from '../ui/WhatsAppButton.astro';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';

interface Props {
  /** Identidad del negocio — la inyecta la página que lo monta. */
  site: Site;
}
const { site } = Astro.props;
const hoursLabel = formatHours(site.hours);
const mapSrc = `https://maps.google.com/maps?q=${site.geo.lat},${site.geo.lng}&hl=es&z=15&output=embed`;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${site.geo.lat},${site.geo.lng}`;
---
<section id="ubicacion" class="bg-white py-12 md:py-16">
  <Container>
    <div class="grid gap-8 md:grid-cols-2">
      <div>
        <h2 class="font-display text-h2 md:text-h2-lg font-semibold text-ink">Ubicación y contacto</h2>
        <address class="mt-4 not-italic text-neutral">
          <p>
            <strong class="text-primary">Dirección</strong><br />
            {site.address.street}, {site.address.city}
          </p>
          <p class="mt-3">
            <strong class="text-primary">Teléfono</strong><br />
            <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="inline-flex min-h-11 items-center hover:text-primary">{site.phone}</a>
          </p>
          <p class="mt-3">
            <strong class="text-primary">Horario</strong><br />
            {hoursLabel}
          </p>
          <p class="mt-3">
            <strong class="text-primary">Correo</strong><br />
            <a href={`mailto:${site.email}`} class="inline-flex min-h-11 items-center hover:text-primary">{site.email}</a>
          </p>
        </address>
      {/* Móvil: ambos botones viven antes del iframe en el DOM (§4). */}
      <div class="mt-6 flex flex-wrap gap-3">
        <WhatsAppButton {site} message={generalWhatsappMessage()} label="Escríbenos por WhatsApp" />
        <Button href={mapsUrl} variant="outline">Cómo llegar</Button>
      </div>
      </div>
      <iframe
        src={mapSrc}
        title={`Mapa de ${site.name} en ${site.address.city}`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        class="h-80 w-full rounded-xl border-0 md:h-full"
      ></iframe>
    </div>
  </Container>
</section>
