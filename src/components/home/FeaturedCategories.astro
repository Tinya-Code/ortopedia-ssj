---
// Categorías con enlace interno a su landing (/catalogo/[slug]/) y anchor text descriptivo.
import Container from "../ui/Container.astro";
import ChevronDown from "../icons/ChevronDown.astro";
import CategoryCard from "../catalog/CategoryCard.astro";

interface Category {
  slug: string;
  name: string;
  seoDescription: string;
  image: ImageMetadata | string;
  imageAlt: string;
}
interface Props {
  categories: Category[];
}
const { categories } = Astro.props;
---

<section class="py-12 md:py-16 relative">
  <Container>
    <div>
      <h2 class="font-display text-h2 md:text-h2-lg font-semibold text-ink">
        Categorías de productos
      </h2>
    </div>
    <div class="relative mt-6">
      <ul
        class="flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth pb-4 no-scrollbar sm:gap-6"
        data-carousel-track
      >
        {
          categories.map((c) => (
            <li class="w-[min(82vw,20rem)] shrink-0 snap-start sm:w-[calc(50%_-_0.75rem)] lg:w-[calc(33.333%_-_1rem)]">
              <CategoryCard category={c} titleTag="h3" class="h-full" />
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
  <div
    class="pointer-events-none absolute inset-0 z-10 mx-auto max-w-7xl"
    role="group"
    aria-label="Controles de categorías"
  >
    <button
      type="button"
      class="pointer-events-auto mx-4 absolute top-1/2 flex size-11 -translate-y-1/2 items-center justify-center rounded-lg border border-neutral/30 bg-white text-ink shadow-card transition hover:border-primary hover:text-primary disabled:cursor-not-allowed disabled:opacity-0"
      aria-label="Ver categorías anteriores"
      data-carousel-prev
    >
      <ChevronDown class="size-5 rotate-90" />
    </button>
    <button
      type="button"
      class="pointer-events-auto mx-4 absolute right-0 top-1/2 flex size-11 -translate-y-1/2 items-center justify-center rounded-lg border border-neutral/30 bg-white text-ink shadow-card transition hover:border-primary hover:text-primary disabled:cursor-not-allowed disabled:opacity-0"
      aria-label="Ver más categorías"
      data-carousel-next
    >
      <ChevronDown class="size-5 -rotate-90" />
    </button>
  </div>
</section>

<script>
  document.querySelectorAll("[data-carousel-track]").forEach((track) => {
    const section = track.closest("section");
    const previous = section?.querySelector<HTMLButtonElement>(
      "[data-carousel-prev]",
    );
    const next = section?.querySelector<HTMLButtonElement>(
      "[data-carousel-next]",
    );
    if (!previous || !next) return;

    const updateControls = () => {
      previous.disabled = track.scrollLeft <= 1;
      next.disabled =
        track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
    };

    const scrollByCard = (direction: number) => {
      const first = track.querySelector("li");
      const second = first?.nextElementSibling;
      const distance =
        first && second
          ? second.getBoundingClientRect().left -
            first.getBoundingClientRect().left
          : (first?.getBoundingClientRect().width ?? 0);
      track.scrollBy({
        left: direction * distance,
        behavior: matchMedia("(prefers-reduced-motion: reduce)").matches
          ? "auto"
          : "smooth",
      });
    };

    previous.addEventListener("click", () => scrollByCard(-1));
    next.addEventListener("click", () => scrollByCard(1));
    track.addEventListener("scroll", updateControls, { passive: true });
    window.addEventListener("resize", updateControls);
    updateControls();
  });
</script>
