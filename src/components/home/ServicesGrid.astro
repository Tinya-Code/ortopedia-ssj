---
// Los datos viven en pages/index.astro (capa smart), no en data/.
// id="servicios" es obligatorio: el header enlaza a /#servicios.
import { Image } from 'astro:assets';
import Container from '../ui/Container.astro';

interface Service {
  title: string;
  text: string;
  href: string;
  image: ImageMetadata;
  imageAlt: string;
}
interface Props {
  services: Service[];
}
const { services } = Astro.props;

// Bento Grid: card destacada (izquierda, vertical) + dos cards en fila (derecha).
const cardBase =
  'group relative flex h-full flex-col overflow-hidden rounded-3xl border border-neutral/15 bg-white transition-all duration-300 ease-out hover:-translate-y-1 hover:border-primary/40 hover:shadow-xl hover:shadow-neutral/10';
const imageBoxBase = 'order-1 h-56 w-full shrink-0 overflow-hidden md:h-64';
const imageClass =
  'h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105';
const textBoxBase = 'order-2 flex flex-1 flex-col justify-between p-6 md:p-8';
---
<section id="servicios" class="bg-light py-12 md:py-16">
  <Container>
    <h2 class="font-display text-3xl font-semibold text-ink">Servicios</h2>
    <p class="mt-4 max-w-prose text-neutral">
      Acompañamiento personalizado en cada etapa: desde la evaluación hasta la elección del
      producto ortopédico adecuado.
    </p>
    <ul class="mt-6 grid w-full grid-cols-1 gap-6 lg:grid-cols-12 lg:items-stretch">
      {services.map((s, i) => {
        const featured = i === 0;
        const liClass = featured ? 'lg:col-span-5 lg:row-span-2' : 'lg:col-span-7';
        const cardClass = featured ? cardBase : `${cardBase} lg:flex-row lg:items-stretch`;
        const imageBoxClass = featured
          ? `${imageBoxBase} lg:order-1 lg:h-72 lg:w-full`
          : `${imageBoxBase} lg:order-2 lg:h-auto lg:w-5/12 lg:min-h-full`;
        const textBoxClass = featured
          ? `${textBoxBase} lg:order-2 lg:p-8`
          : `${textBoxBase} lg:order-1 lg:p-8`;
        return (
          <li class={liClass}>
            <a href={s.href} class={cardClass}>
              <div class={imageBoxClass}>
                <Image
                  src={s.image}
                  alt={s.imageAlt}
                  width={640}
                  height={400}
                  format="webp"
                  loading="lazy"
                  decoding="async"
                  class={imageClass}
                />
              </div>
              <div class={textBoxClass}>
                <div>
                  <h3 class="text-xl font-semibold tracking-tight text-ink md:text-2xl">{s.title}</h3>
                  <p class="mb-6 mt-2 text-sm leading-relaxed text-neutral md:text-base">{s.text}</p>
                </div>
                <span class="inline-flex items-center gap-2 font-medium text-primary transition-colors duration-200 group-hover:text-secondary">
                  Ver más
                  <svg
                    aria-hidden="true"
                    class="h-4 w-4 shrink-0 transition-transform duration-200 group-hover:translate-x-1.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M5 12h14M12 5l7 7-7 7" />
                  </svg>
                </span>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
    {/* TODO Fase 9+: si existen páginas /servicios/[slug]/, apuntar href ahí en vez de WhatsApp. */}
  </Container>
</section>
