---
// Los datos viven en pages/index.astro (capa smart), no en data/.
// id="servicios" es obligatorio: el header enlaza a /#servicios.
import Container from '../ui/Container.astro';

interface Service {
  title: string;
  text: string;
  href: string;
  icon: string; // path SVG (stroke), definido en la página
}
interface Props {
  services: Service[];
}
const { services } = Astro.props;
---
<section id="servicios" class="bg-neutral/5 py-12 md:py-16">
  <Container>
    <h2 class="font-display text-3xl font-semibold text-ink">Servicios</h2>
    <p class="mt-4 max-w-prose text-neutral">
      Acompañamiento personalizado en cada etapa: desde la evaluación hasta la elección del
      producto ortopédico adecuado.
    </p>
    <ul class="mt-6 grid gap-4 sm:gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => (
        <li>
          <a
            href={s.href}
            class="flex h-full flex-col rounded-card border border-neutral/20 bg-white p-6 shadow-card transition hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md motion-reduce:transition-none"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg
              aria-hidden="true"
              class="size-10 text-primary"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d={s.icon} />
            </svg>
            <h3 class="mt-3 font-display text-lg font-semibold text-ink">{s.title}</h3>
            <p class="mt-2 flex-1 text-sm text-neutral">{s.text}</p>
            <span class="mt-4 text-sm font-semibold text-secondary">Consultar →</span>
          </a>
        </li>
      ))}
    </ul>
    {/* TODO Fase 9+: si existen páginas /servicios/[slug]/, apuntar href ahí en vez de WhatsApp. */}
  </Container>
</section>
