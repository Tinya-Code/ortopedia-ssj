---
// mejoras.md §5.8 — franja de hechos verificables bajo el hero. Sin <h2> (no es
// una sección con título: es una franja, por eso lleva aria-label).
import Container from '../ui/Container.astro';

interface Props {
  items: { icon: string; label: string }[];
}
const { items } = Astro.props;
---
<section aria-label="Información de confianza" class="border-y border-neutral/20 bg-white py-6">
  <Container>
    <ul class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm md:grid-cols-4" role="list">
      {items.map((it) => (
        <li class="flex items-center gap-2.5 text-neutral">
          <svg
            aria-hidden="true"
            class="size-5 shrink-0 text-primary"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d={it.icon} />
          </svg>
          <span>{it.label}</span>
        </li>
      ))}
    </ul>
  </Container>
</section>
