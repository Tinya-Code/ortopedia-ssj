---
// Solo afirmaciones verificables del negocio. Lenguaje YMYL: sin promesas de cura
// ("brinda soporte", "ayuda a estabilizar"), nunca "cura" o "recuperación garantizada".
import Container from '../ui/Container.astro';

const points = [
  {
    title: 'Productos con registro sanitario',
    text: 'Publicamos únicamente productos con registro sanitario verificado y datos de titular visibles en la ficha.',
    // shield-check
    icon: 'M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1zM9 12l2 2 4-4',
  },
  {
    title: 'Asesoramiento personalizado',
    text: 'Te orientamos según tu caso y tus medidas para que elijas el producto que brinda soporte adecuado.',
    // user-check
    icon: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm7 0 2 2 4-4',
  },
  {
    title: 'Atención directa por WhatsApp',
    text: 'Resolvemos dudas de talla, stock, precios con IGV y comprobante de pago sin demoras.',
    // message-circle
    icon: 'M7.9 20A9 9 0 1 0 4 16.1L2 22Z',
  },
  {
    title: 'Comprobante y entrega coordinada',
    text: 'Emitimos comprobante electrónico en cada venta y coordinamos la entrega contigo.',
    // receipt
    icon: 'M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1zM16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8M12 17.5v-11',
  },
];
---
<section class="bg-neutral/5 py-12 md:py-16">
  <Container>
    <h2 class="font-display text-3xl font-semibold text-ink">Por qué elegirnos</h2>
    <ul class="mt-6 grid gap-4 sm:gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {points.map((p) => (
        <li class="rounded-card border border-neutral/20 bg-white p-6 shadow-card">
          <svg
            aria-hidden="true"
            class="size-8 text-secondary"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d={p.icon} />
          </svg>
          <h3 class="mt-3 font-display text-lg font-semibold text-ink">{p.title}</h3>
          <p class="mt-2 text-sm text-neutral">{p.text}</p>
        </li>
      ))}
    </ul>
  </Container>
</section>
