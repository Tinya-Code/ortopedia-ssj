---
// El JSON-LD (faqSchema) lo arma pages/index.astro y lo pasa a BaseLayout; aquí
// solo HTML — el acordeón consume el mismo array que el schema.
import Container from '../ui/Container.astro';
import Accordion from '../ui/Accordion.astro';

interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---
<section class="bg-neutral/5 py-12 md:py-16">
  <Container size="narrow">
    <h2 class="font-display text-3xl font-semibold text-ink">Preguntas frecuentes</h2>
    <div class="mt-6">
      <Accordion {items} />
    </div>
  </Container>
</section>
