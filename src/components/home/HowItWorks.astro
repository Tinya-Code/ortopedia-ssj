---
// mejoras.md §5.7 — pasos de compra por WhatsApp. Los datos viven en la página
// (capa smart). Conector horizontal solo en md, dibujado entre círculos.
import Container from '../ui/Container.astro';

interface Props {
  steps: { title: string; text: string }[];
}
const { steps } = Astro.props;
---
<section class="bg-white py-12 md:py-16">
  <Container>
    <h2 class="font-display text-3xl font-semibold text-ink">Cómo funciona</h2>
    <ol class="mt-6 grid gap-8 md:grid-cols-4 md:gap-6">
      {steps.map((s, i) => (
        <li class="relative">
          <span
            class="flex size-9 items-center justify-center rounded-full bg-primary text-sm font-semibold text-white"
          >
            {i + 1}
          </span>
          {i < steps.length - 1 && (
            <span
              aria-hidden="true"
              class="absolute left-11 -right-6 top-[18px] hidden h-px bg-neutral/30 md:block"
            />
          )}
          <h3 class="mt-3 font-display text-base font-semibold text-ink">{s.title}</h3>
          <p class="mt-1 text-sm text-neutral">{s.text}</p>
        </li>
      ))}
    </ol>
  </Container>
</section>
