---
// mejoras.md §5.8 — franja de hechos verificables bajo el hero. Sin <h2> (no es
// una sección con título: es una franja, por eso lleva aria-label).
import Container from '../ui/Container.astro';

interface Props {
  items: { label: string; image: string }[];
}
const { items } = Astro.props;
---
<section aria-label="Top de productos más vendidos" class="border-y border-neutral/20 bg-white py-6">
  <Container>
    <ul class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm md:grid-cols-4" role="list">
      {items.map((it) => {
        return (
          <li class="flex flex-col items-center gap-2.5 text-neutral">
            <div class="bg-neutral/10 p-2 rounded-full">
              <img src={it.image} alt={it.label} class="size-16" />
            </div>
            <span class="text-sm">{it.label}</span>
          </li>
        );
      })}
    </ul>
  </Container>
</section>
