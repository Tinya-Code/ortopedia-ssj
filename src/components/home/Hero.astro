---
// Único <h1> de la home. La imagen es el LCP: fetchpriority="high", sin lazy.
import { Image } from 'astro:assets';

interface Props {
  title: string;
  text?: string;
  image: ImageMetadata;
  imageAlt: string;
}
const { title, text, image, imageAlt } = Astro.props;
---
<section class="bg-white">
  <div class="mx-auto grid max-w-6xl items-center gap-8 px-4 py-12 md:grid-cols-2">
    <div>
      <h1 class="font-display text-4xl font-semibold leading-tight text-ink md:text-5xl">
        {title}
      </h1>
      {text && <p class="mt-4 max-w-prose text-lg text-neutral">{text}</p>}
      <div class="mt-6">
        <slot />
      </div>
    </div>
    <Image
      src={image}
      alt={imageAlt}
      width={1600}
      height={900}
      widths={[600, 1000, 1600]}
      sizes="(min-width: 768px) 50vw, 100vw"
      format="webp"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="h-auto w-full rounded-xl"
    />
  </div>
</section>
