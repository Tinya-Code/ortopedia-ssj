---
// Único <h1> de la home. La imagen es el LCP: fetchpriority="high", sin lazy.
// La imagen cubre toda la sección como fondo; texto y acciones van encima.
// El scrim garantiza contraste AA del texto claro sobre la imagen.
import { Image } from 'astro:assets';
import Container from '../ui/Container.astro';

interface Props {
  title: string;
  text?: string;
  image: ImageMetadata;
}
const { title, text, image } = Astro.props;
---
<section class="relative  h-[calc(100vh-63px)] isolate bg-primary flex items-center">
  <Image
    src={image}
    alt=""
    width={2752}
    height={1536}
    widths={[960, 1440, 1920, 2752]}
    sizes="100vw"
    format="webp"
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="absolute inset-0 -z-10 h-full w-full object-cover"
  />
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10 bg-linear-to-b from-primary via-primary via-35% to-transparent md:bg-linear-to-r md:via-10%"
  />
  <Container>
    <div class="max-w-md pt-16 pb-24 md:py-24 lg:max-w-xl">
      <h1 class="font-display text-4xl font-semibold leading-tight text-white md:text-5xl">
        {title}
      </h1>
      {text && <p class="mt-4 max-w-prose text-lg text-white">{text}</p>}
      <div class="mt-6 flex flex-wrap gap-3">
        <slot />
      </div>
    </div>
  </Container>
</section>
